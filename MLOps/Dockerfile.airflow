FROM apache/airflow:2.9.3-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/project /opt/airflow/logs /opt/airflow/plugins \
    && chown -R airflow:root /opt/project /opt/airflow \
    && chmod -R g+rwX /opt/airflow /opt/project

USER airflow
COPY MLOps/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt
